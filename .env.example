# Copy to .env (gitignored) and fill in. Nothing reads .env automatically:
# export these in your shell or service manager, or load the file yourself.
# Everything here is optional; with none of it set the game runs exactly as
# before (JSON saves in gameserver/).

# --- game server (gameserver/, Go) ----------------------------------------
# Save backend: json (default, gameserver/world.<worldId>.save.json) or postgres.
HEARTH_STORE=json
# Required when HEARTH_STORE=postgres. Apply the schema first:
#   cd gameserver && go run ./cmd/dbmigrate
# Add ?sslmode=require (or verify-full) for a managed/remote Postgres.
DATABASE_URL=postgres://hearth:change-me@localhost:5432/hearth?sslmode=disable
# Set to disable saving entirely (wins over HEARTH_STORE).
# HEARTH_NO_PERSIST=1

# Only for `go test ./persist/pgstore/`: a database the test role may CREATE
# SCHEMA in. Each run uses (and drops) its own throwaway schema.
# HEARTH_TEST_DATABASE_URL=postgres://hearth:change-me@localhost:5432/hearth_test?sslmode=disable

# --- control plane (control/, Node) ---------------------------------------
# Pin the userId HMAC secret in any real deployment: rotating it renames every
# account and orphans every save (control/identity.js).
# HEARTH_ID_SECRET=
