# dependencies / build output
node_modules/
dist/

# baked by tools/atlas/build-atlases.mjs (npm run atlas) — derived from the SVGs, never committed
assets/atlas/
src/generated/

# runtime state (world save — delete-able, never commit)
server/save.json
gameserver/world.save.json
gameserver/world.*.save.json
# the pre-migration copy a map change makes of an older save (save.json.v4.bak)
*.save.json.v*.bak
server/save.json.v*.bak

# logs & scratch
*.log
srv.log
vite.log

# environment / secrets
.env
.env.*
# derived-userId HMAC key: machine-local, and rotating it orphans every save
control/.id-secret

# editor & OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Agents folders
.claude
.codex
